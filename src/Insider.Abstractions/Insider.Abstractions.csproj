<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Insider.Abstractions</AssemblyName>
    <RootNamespace>Insider</RootNamespace>
    <Description>Plugin contracts for the Insider Unity mod loader.</Description>
    <PackageId>Insider.Unity.Abstractions</PackageId>
    <VersionPrefix>$(InsiderVersion)</VersionPrefix>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoMod.Utils" Version="25.0.14" />
  </ItemGroup>
</Project>
