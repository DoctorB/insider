<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Insider.Loader</AssemblyName>
    <RootNamespace>Insider.Loader</RootNamespace>
    <Description>Managed plugin chainloader for Insider.</Description>
    <PackageId>Insider.Unity.Loader</PackageId>
    <VersionPrefix>$(InsiderVersion)</VersionPrefix>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Insider.Abstractions/Insider.Abstractions.csproj" />
  </ItemGroup>
</Project>
