<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Insider.Tests</AssemblyName>
    <RootNamespace>Insider.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Insider.Abstractions/Insider.Abstractions.csproj" />
    <ProjectReference Include="../../src/Insider.Bootstrap/Insider.Bootstrap.csproj" />
    <ProjectReference Include="../../src/Insider.Cli/Insider.Cli.csproj" />
    <ProjectReference Include="../../src/Insider.Hooking/Insider.Hooking.csproj" />
    <ProjectReference Include="../../src/Insider.Installation/Insider.Installation.csproj" />
    <ProjectReference Include="../../src/Insider.Loader/Insider.Loader.csproj" />
    <ProjectReference Include="../Insider.PluginFixture/Insider.PluginFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../Insider.DependencyFixture.V2/Insider.DependencyFixture.V2.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyManagedTestFixtures" AfterTargets="Build">
    <MakeDir Directories="$(OutDir)fixtures/bootstrap;$(OutDir)fixtures/dependencies/v1;$(OutDir)fixtures/dependencies/v2" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/../Insider.PluginFixture/bin/$(Configuration)/netstandard2.0/Insider.PluginFixture.dll"
      DestinationFolder="$(OutDir)fixtures/bootstrap" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/../Insider.DependencyFixture.V1/bin/$(Configuration)/netstandard2.0/Insider.DependencyFixture.dll"
      DestinationFolder="$(OutDir)fixtures/dependencies/v1" />
    <Copy
      SourceFiles="$(MSBuildProjectDirectory)/../Insider.DependencyFixture.V2/bin/$(Configuration)/netstandard2.0/Insider.DependencyFixture.dll"
      DestinationFolder="$(OutDir)fixtures/dependencies/v2" />
  </Target>
</Project>
